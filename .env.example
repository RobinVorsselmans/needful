# Kopieer naar .env en vul in. .env staat in .gitignore.

# Database
DATABASE_URL=postgresql+psycopg://needful:needful@localhost:5432/needful

# LLM via OpenRouter. Leeg = de app toont het voorbeeld (hogedrukreiniger) in plaats van het LLM.
# Getest op "wasmachine" in Antwerpen (nov. 2026), kost per product = inzichten + buurt nakijken:
#   anthropic/claude-haiku-5.5   ± $0,0026  beste oordeel: Oxfam weg, Kringwinkels blijven
#   openai/gpt-oss-120b          ± $0,0011  te streng (alle Kringwinkels weg), rare alternatieven
#   google/gemini-2.5-flash-lite ± $0,0011  te mild (Oxfam en een kassazaak blijven staan)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_PORT=8080
RATE_LIMIT_PER_MINUTE=10

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
